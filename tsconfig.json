{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // "typeRoots": ["./src/types", "./node_modules/@types"]
    "typeRoots": ["./node_modules/@types", "./src/types"]
  }
}
